mapscripts NorthCampus_Classroom2_MapScripts {}

script NorthCampus_Classroom2_NPC1 {
    lock
    faceplayer
    msgbox(format("There was a time when {COLOR RED}Psychic-type {COLOR DARK_GRAY}Pokémon were considered to be the most powerful of all.\pSadly, that time has passed…"))
    closemessage
    release
    end
}

script NorthCampus_Classroom2_NPC2 {
    lock
    faceplayer
    msgbox(format("I have Professor Maple for Berry Blending 101.\pShe's super nice!"))
    closemessage
    release
    end
}

script NorthCampus_Classroom2_Chalkboard_EVs {
    msgbox(format("Some leftover lecture notes on the chalkboard.\p'{COLOR GREEN}Effort Values{COLOR DARK_GRAY}, or {COLOR GREEN}EVs{COLOR DARK_GRAY}, are stats that influence a Pokemon's growth.\pBy battling certain Pokémon, your Pokémon can gain EVs in specific stats.\pThese values can be viewed in your Pokémon's {COLOR GREEN}Summary Screen{COLOR DARK_GRAY}.'"))
    closemessage
    end
}

script NorthCampus_Classroom_Skeleton {
    msgbox(format("A human skeleton model used for educational purposes.\pHumans and Pokémon share many similar bone structures."))
    closemessage
    end
}


