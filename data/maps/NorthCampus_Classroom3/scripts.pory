mapscripts NorthCampus_Classroom3_MapScripts {}

script NorthCampus_Classroom3_NPC1 {
    lock
    faceplayer
    msgbox(format("Ugh, this class is hard.\nI have to actually study!"))
    closemessage
    release
    end
}

script NorthCampus_Classroom3_NPC2 {
    lock
    faceplayer
    msgbox(format("Have you taken Water Pokémon Habits and Habitats?\pIt's my favorite class so far!\pNext to Famous Fishing Folk Fables, that is."))
    closemessage
    release
    end
}

script NorthCampus_Classroom3_Chalkboard_Natures {
    msgbox(format("Some leftover lecture notes on the chalkboard.\p'{COLOR GREEN}Natures{COLOR DARK_GRAY} affect how a Pokémon's stats grow.\pEach Nature increases one stat by 10% and decreases another by 10%.\pThese effects can be viewed in your Pokémon's {COLOR GREEN}Summary Screen{COLOR DARK_GRAY}, where the increased stat is {COLOR RED}red{COLOR DARK_GRAY} and the decreased stat is {COLOR BLUE}blue{COLOR DARK_GRAY}.'"))
    closemessage
    end
}
